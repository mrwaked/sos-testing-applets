{
  "name": "@kral/memory-filler-test",
  "version": "1.0.0",
  "author": "",
  "main": "dist/index.html",
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "upload": "sos applet upload",
    "clean": "npx rimraf dist",
    "escheck": "npx es-check --module es5 dist/**/*.js",
    "postbuild": "npm run escheck",
    "start": "webpack serve --mode development",
    "build": "npm run check-types && webpack --mode production",
    "connect": "echo \"Deprecated command \\\"npm run connect\\\". Use \\\"npm run watch\\\" instead.\" && npm run watch",
    "watch": "webpack --watch",
    "check-types": "tsc --noEmit"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "description": "signageOS applet",
  "repository": {},
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@signageos/front-applet": "^8.5.1",
    "@signageos/front-display": "^14.30.0",
    "@signageos/webpack-plugin": "^1.1.1",
    "babel-loader": "^10.0.0",
    "core-js": "^3.48.0",
    "css-loader": "^7.1.2",
    "es-check": "^9.5.4",
    "html-webpack-plugin": "^5.6.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "sos": {
    "appletUid": "6a381574a70350918488595f4f386d3b49f002e9edf72ce6a8",
    "appletVersion": "1.0.0",
    "config": [
      {
        "name": "chunkSizeMB",
        "valueType": "number",
        "description": "Chunk size in MB to fill memory with every (x) interval",
        "placeholder": "10",
        "mandatory": true
      },
      {
        "name": "intervalMS",
        "valueType": "number",
        "description": "Interval in milliseconds to fill memory",
        "placeholder": "10000",
        "mandatory": true
      }
    ]
  }
}
